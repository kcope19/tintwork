{
  "name": "Tintwork image editor",
  "short_name": "Tintwork",
  "description": "An original, layered photo editor that runs entirely in your browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16171b",
  "theme_color": "#16171b",
  "categories": [
    "photo",
    "graphics",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "src/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/vnd.adobe.photoshop": [
          ".psd",
          ".psb"
        ],
        "image/x-camera-raw": [
          ".dng",
          ".cr2",
          ".cr3",
          ".crw",
          ".nef",
          ".nrw",
          ".arw",
          ".srf",
          ".sr2",
          ".raf",
          ".orf",
          ".rw2",
          ".rwl",
          ".pef",
          ".srw",
          ".erf",
          ".3fr",
          ".fff",
          ".iiq",
          ".mos",
          ".mef",
          ".mrw",
          ".x3f",
          ".kdc",
          ".dcr"
        ],
        "application/x-tintwork+json": [
          ".tintwork"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "New canvas",
      "short_name": "New",
      "url": "./?action=new",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Open a file",
      "short_name": "Open",
      "url": "./?action=open",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Open recent",
      "short_name": "Recent",
      "url": "./?action=recent",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
